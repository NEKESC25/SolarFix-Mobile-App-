# ============================================================================
# SOLARFIX ENVIRONMENT & SECRETS CONFIGURATION (.env.example)
# ============================================================================
# SECURITY POLICY:
# 1. NEVER commit real API keys or secret credentials to Git (.env is gitignored).
# 2. Configure actual credentials exclusively via the AI Studio Secrets panel
#    or your server-side Cloud Functions / Edge Functions secret manager.
# 3. Mobile client builds (BuildConfig) ONLY receive public-designated keys.
#    All *_SECRET_KEY variables are explicitly blocked from mobile APK compilation
#    via secrets.ignoreList in app/build.gradle.kts and are consumed exclusively
#    by server-side backend functions.
# ============================================================================

# --- PUBLIC CLIENT CONFIGURATION (Safe for Mobile Frontend) ---
# Only public keys (e.g. pk_test_... or pk_live_...) may be assigned here.
PAYSTACK_PUBLIC_KEY=YOUR_PAYSTACK_PUBLIC_KEY

# --- SERVER-SIDE ONLY SECRETS (Excluded from Mobile APK via secrets.ignoreList) ---
# Used exclusively by SolarFix Backend Cloud/Edge Functions for server-side
# transaction verification, split settlements, and HMAC-SHA512 webhook validation
# via the 'x-paystack-signature' header. Never sent to the mobile client.
PAYSTACK_SECRET_KEY=YOUR_PAYSTACK_SECRET_KEY

# Note on Google AI Services:
# SolarFix uses Firebase AI Logic (Gemini API) secured by Firebase App Check
# server-side attestation. No client-side GEMINI_API_KEY is used or exposed.
