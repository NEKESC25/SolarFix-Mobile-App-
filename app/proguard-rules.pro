# Hide original source file names in production stack traces
-renamesourcefileattribute SourceFile

# Strip verbose and debug logs in production builds so sensitive debug information is never emitted
-assumenosideeffects class android.util.Log {
    public static boolean isLoggable(java.lang.String, int);
    public static int v(...);
    public static int d(...);
}

