<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Enforce HTTPS-only (TLS 1.2+) across the entire SolarFix application -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Explicit domain security configuration for Paystack & SolarFix endpoints -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.paystack.co</domain>
        <domain includeSubdomains="true">checkout.paystack.com</domain>
        <domain includeSubdomains="true">solarfix.africa</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">firebaseio.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
